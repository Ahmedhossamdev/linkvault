{
  "manifest_version": 3,
  "minimum_chrome_version": "123",
  "name": "LinkVault",
  "version": "0.3.1",
  "description": "A local reading library for links shared across LinkedIn chats, with portable backups and Markdown export.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "action": {"default_title": "Open LinkVault", "default_icon": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"}},
  "background": {"service_worker": "background.js"}
}
